@model IntranetHub.Models.MuralViewModel
@{ ViewData["Title"] = "Gerenciar Mural"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Index" class="btn btn-secondary">Voltar ao Mural</a>
</div>

<div class="row">
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white">Adicionar Aviso</div>
            <div class="card-body">
                <form asp-action="AddAviso" method="post" class="mb-3">
                    <input type="text" name="Title" class="form-control mb-2" placeholder="Título" required />
                    <textarea name="Content" class="form-control mb-2" rows="3" placeholder="Conteúdo" required></textarea>
                    <button type="submit" class="btn btn-primary w-100">Salvar Aviso</button>
                </form>
                <hr />
                <ul class="list-group">
                    @foreach (var a in Model.Avisos) {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><strong>@a.Title</strong></span>
                            <form asp-action="DeleteAviso" method="post"><input type="hidden" name="id" value="@a.Id" /><button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button></form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-4">
        <div class="card shadow-sm border-success">
            <div class="card-header bg-success text-white">Adicionar Aniversário</div>
            <div class="card-body">
                <form asp-action="AddAniversario" method="post" class="mb-3">
                    <input type="text" name="EmployeeName" class="form-control mb-2" placeholder="Nome" required />
                    <input type="text" name="Department" class="form-control mb-2" placeholder="Setor" required />
                    <input type="date" name="Date" class="form-control mb-2" required />
                    <button type="submit" class="btn btn-success w-100">Salvar Aniversário</button>
                </form>
                <hr />
                <ul class="list-group">
                    @foreach (var a in Model.Aniversarios) {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span><strong>@a.EmployeeName</strong> (@a.Date.ToString("dd/MM"))</span>
                            <form asp-action="DeleteAniversario" method="post"><input type="hidden" name="id" value="@a.Id" /><button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button></form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>