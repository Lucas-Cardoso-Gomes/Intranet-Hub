@model IntranetHub.Models.MuralViewModel
@{ ViewData["Title"] = "Mural RH"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-megaphone"></i> @ViewData["Title"]</h2>
    @if (User.Identity?.IsAuthenticated == true) { <a asp-action="Manage" class="btn btn-outline-primary">Gerenciar Mural</a> }
</div>

<div class="row">
    <!-- Avisos -->
    <div class="col-md-6 mb-4">
        <h4 class="text-primary border-bottom pb-2">Avisos Importantes</h4>
        @if (!Model.Avisos.Any()) { <div class="alert alert-info">Nenhum aviso ativo.</div> }
        @foreach (var aviso in Model.Avisos)
        {
            <div class="card mb-3 border-primary shadow-sm">
                <div class="card-header bg-primary text-white fw-bold">@aviso.Title</div>
                <div class="card-body"><p class="card-text">@aviso.Content</p></div>
                <div class="card-footer text-muted small">Publicado: @aviso.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        }
    </div>

    <!-- Aniversários -->
    <div class="col-md-6 mb-4">
        <h4 class="text-success border-bottom pb-2">Aniversariantes do Mês</h4>
        @if (!Model.Aniversarios.Any()) { <div class="alert alert-info">Nenhum aniversariante este mês.</div> }
        <ul class="list-group">
        @foreach (var aniv in Model.Aniversarios)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center border-success mb-2 rounded shadow-sm">
                <div>
                    <strong class="text-success">@aniv.EmployeeName</strong> <br />
                    <small class="text-muted"><i class="bi bi-building"></i> @aniv.Department</small>
                </div>
                <span class="badge bg-success rounded-pill p-2" style="font-size: 1.1em;">
                    <i class="bi bi-calendar-event"></i> Dia @aniv.Date.ToString("dd/MM")
                </span>
            </li>
        }
        </ul>
    </div>
</div>