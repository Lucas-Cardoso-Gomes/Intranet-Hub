@model IEnumerable<IntranetHub.Models.Contact>
@{ ViewData["Title"] = "Gerenciar Contatos"; }
<h2 class="mb-4">@ViewData["Title"]</h2>
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddContact" method="post" class="card card-body shadow-sm">
            <h5 class="card-title border-bottom pb-2">Novo Contato</h5>
            <input type="text" name="Name" class="form-control mb-2" placeholder="Nome" required />
            <input type="text" name="Department" class="form-control mb-2" placeholder="Setor" required />
            <input type="text" name="ExtensionLine" class="form-control mb-2" placeholder="Ramal" />
            <input type="email" name="Email" class="form-control mb-3" placeholder="E-mail" />
            <button type="submit" class="btn btn-primary">Salvar</button>
        </form>
    </div>
    <div class="col-md-8">
        <ul class="list-group shadow-sm">
            @foreach (var c in Model) {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><strong>@c.Name</strong> (@c.Department) - Ramal: @c.ExtensionLine</span>
                    <form asp-action="DeleteContact" method="post"><input type="hidden" name="id" value="@c.Id" /><button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></button></form>
                </li>
            }
        </ul>
    </div>
</div>