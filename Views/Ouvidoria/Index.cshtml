@model IntranetHub.Models.OuvidoriaMessage
@{ ViewData["Title"] = "Ouvidoria / Canal RH"; }

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-envelope-paper"></i> @ViewData["Title"]</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">Canal seguro para enviar sugestões, críticas ou mensagens ao RH. Você pode enviar anonimamente.</p>
                    
                    @if (TempData["SuccessMessage"] != null) {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }

                    <form asp-action="Index" method="post">
                        <div class="mb-3 form-check form-switch">
                            <input asp-for="IsAnonymous" class="form-check-input" type="checkbox" id="anonSwitch" onchange="toggleFields()">
                            <label class="form-check-label fw-bold" for="anonSwitch">Enviar de forma anônima</label>
                        </div>
                        <div id="identityFields">
                            <div class="mb-3"><label class="form-label">Nome</label><input asp-for="Name" class="form-control" /></div>
                            <div class="mb-3"><label class="form-label">E-mail</label><input asp-for="Email" class="form-control" type="email" /></div>
                        </div>
                        <div class="mb-3"><label class="form-label fw-bold">Assunto</label><input asp-for="Subject" class="form-control" required /></div>
                        <div class="mb-4"><label class="form-label fw-bold">Mensagem</label><textarea asp-for="Message" class="form-control" rows="5" required></textarea></div>
                        <button type="submit" class="btn btn-dark w-100"><i class="bi bi-send"></i> Enviar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleFields() {
        document.getElementById('identityFields').style.display = document.getElementById('anonSwitch').checked ? 'none' : 'block';
    }
</script>