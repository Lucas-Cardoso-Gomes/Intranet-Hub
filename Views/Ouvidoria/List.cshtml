@model IEnumerable<IntranetHub.Models.OuvidoriaMessage>
@{ ViewData["Title"] = "Caixa de Entrada - Ouvidoria"; }

<h2 class="mb-4"><i class="bi bi-inbox"></i> @ViewData["Title"]</h2>
<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light"><tr><th>Data</th><th>Remetente</th><th>Assunto</th></tr></thead>
            <tbody>
                @foreach (var msg in Model) {
                    <tr>
                        <td>@msg.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(msg.IsAnonymous ? "Anônimo" : $"{msg.Name} ({msg.Email})")</td>
                        <td><strong>@msg.Subject</strong> <br/> <small class="text-muted d-inline-block text-truncate" style="max-width: 300px;">@msg.Message</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>