@model IEnumerable<IntranetHub.Models.Pop>
@{ ViewData["Title"] = "Procedimentos (POPs)"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-text"></i> @ViewData["Title"]</h2>
    @if (User.Identity.IsAuthenticated) { <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Novo POP</a> }
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4 card-body bg-white shadow-sm rounded">
    <div class="col-md-4"><input type="text" name="searchString" class="form-control" placeholder="Buscar texto..." /></div>
    <div class="col-md-3"><select name="branchId" class="form-select" asp-items="ViewBag.Branches"><option value="">Todas Filiais</option></select></div>
    <div class="col-md-2"><button type="submit" class="btn btn-secondary w-100"><i class="bi bi-search"></i> Filtrar</button></div>
</form>

<div class="row">
    @foreach (var pop in Model) {
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm @(!pop.IsActive ? "opacity-75 bg-light" : "")">
                <div class="card-header bg-white fw-bold">@pop.Subject @(!pop.IsActive ? "(Inativo)" : "")</div>
                <div class="card-body">
                    <p class="text-muted small"><i class="bi bi-building"></i> @(pop.Branch?.Name ?? "Geral") | <i class="bi bi-calendar"></i> @pop.Date.ToString("dd/MM/yyyy")</p>
                    <p class="card-text text-truncate" style="max-height: 4em; overflow:hidden;">@pop.Body</p>
                </div>
                <div class="card-footer bg-white text-end">
                    @if (!string.IsNullOrEmpty(pop.FileAttachmentPath)) { <a href="@pop.FileAttachmentPath" target="_blank" class="btn btn-sm btn-outline-info"><i class="bi bi-paperclip"></i> Ver Anexo</a> }
                    @if (User.Identity.IsAuthenticated) {
                        <form asp-action="ToggleStatus" method="post" class="d-inline"><input type="hidden" name="id" value="@pop.Id" /><button class="btn btn-sm btn-secondary"><i class="bi bi-power"></i></button></form>
                    }
                </div>
            </div>
        </div>
    }