@model IEnumerable<IntranetHub.Models.CincoSAudit>
@{ ViewData["Title"] = "Ranking e Auditorias 5S"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-star-fill text-warning"></i> @ViewData["Title"]</h2>
    <div>
        <a asp-action="Gallery" class="btn btn-outline-info me-2"><i class="bi bi-images"></i> Galeria</a>
        @if (User.Identity.IsAuthenticated) { <a asp-action="Create" class="btn btn-warning"><i class="bi bi-plus-circle"></i> Nova Auditoria</a> }
    </div>
</div>

<div class="row">
    <div class="col-md-5 mb-4">
        <div class="card shadow-sm border-warning h-100">
            <div class="card-header bg-warning text-dark fw-bold"><i class="bi bi-trophy-fill"></i> Ranking Geral 5S</div>
            <ul class="list-group list-group-flush">
                @foreach (var item in ViewBag.Ranking as IEnumerable<dynamic>) {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <strong>@item.BranchName</strong> 
                        <span class="badge bg-warning text-dark rounded-pill">@item.TotalScore pts</span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-7 mb-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light"><i class="bi bi-clock-history"></i> Últimas Auditorias</div>
            <table class="table mb-0">
                <thead class="table-light"><tr><th>Data</th><th>Filial</th><th>Pontuação (Max 50)</th></tr></thead>
                <tbody>
                    @foreach (var audit in Model) {
                        <tr>
                            <td>@audit.AuditDate.ToString("dd/MM/yyyy")</td>
                            <td><strong>@audit.Branch.Name</strong></td>
                            <td>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar bg-success" style="width: @((audit.TotalScore/50.0)*100)%;">@audit.TotalScore</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>